<mxfile host="app.diagrams.net" type="device">
  <diagram name="Actuator Control" id="Actuator-Control">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Actuator Control - Watering" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#222222;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;strokeColor=none;fillColor=none;align=left;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="820" height="40" as="geometry"/></mxCell>
        <mxCell id="start" value="Evaluate watering request" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#222222;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="180" y="110" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="valid" value="Moisture reading&lt;br&gt;valid and fresh?" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#222222;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry x="190" y="200" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="error" value="Pump OFF;&lt;br&gt;report sensor fault" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#222222;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;rounded=0;" vertex="1" parent="1"><mxGeometry x="580" y="225" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="dry" value="Soil below&lt;br&gt;start threshold?" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#222222;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry x="190" y="350" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="cool" value="Cooldown finished?" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#222222;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;rhombus;" vertex="1" parent="1"><mxGeometry x="190" y="500" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="run" value="Run pump with repeated checks" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#222222;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;rounded=0;" vertex="1" parent="1"><mxGeometry x="180" y="670" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="stop" value="Stop at target, invalid reading&lt;br&gt;or maximum run time" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#222222;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;rounded=0;" vertex="1" parent="1"><mxGeometry x="180" y="780" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="record" value="Pump OFF;&lt;br&gt;record stop time" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#222222;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;rounded=0;" vertex="1" parent="1"><mxGeometry x="180" y="900" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="return" value="Return to control loop" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#222222;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="580" y="1010" width="250" height="50" as="geometry"/></mxCell>
        <mxCell id="note" value="PROTOTYPE - Example automatic watering cycle, starting with the pump OFF.&lt;br&gt;Choose start/stop thresholds, maximum run time, freshness limit and cooldown." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#222222;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;strokeColor=none;fillColor=none;align=left;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="820" height="50" as="geometry"/></mxCell>
        <mxCell id="async" value="While watering, keep the main loop running and recheck stop conditions each cycle." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#222222;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;strokeColor=none;fillColor=none;align=left;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="820" height="50" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=13;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="start" target="valid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=13;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="valid" target="error"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=13;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="valid" target="dry"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=13;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dry" target="cool"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
