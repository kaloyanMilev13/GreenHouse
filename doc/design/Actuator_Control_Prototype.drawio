        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=13;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="run" target="stop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
