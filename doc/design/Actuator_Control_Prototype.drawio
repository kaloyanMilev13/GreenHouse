        <mxCell id="fault" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=13;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="error" target="return"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="255"/><mxPoint x="860" y="1035"/></Array></mxGeometry></mxCell>
        <mxCell id="no-dry" value="No: leave pump OFF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=13;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="dry" target="return"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="705" y="405"/></Array></mxGeometry></mxCell>
