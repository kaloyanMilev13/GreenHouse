        </mxCell>
        <mxCell id="events" value="&lt;b&gt;public.watering_events&lt;/b&gt;&lt;br&gt;PK  id: bigint, NOT NULL, sequence default&lt;br&gt;device_id, boot_id: text, NOT NULL&lt;br&gt;cycle_id: bigint, NOT NULL&lt;br&gt;event, reason: text, NOT NULL&lt;br&gt;occurred_at_ms: bigint, NOT NULL&lt;br&gt;duration_ms: bigint, nullable&lt;br&gt;received_at: timestamptz, NOT NULL, default now()&lt;br&gt;is_test: boolean, NOT NULL&lt;br&gt;UNIQUE (device_id, boot_id, cycle_id, event)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#233B43;align=left;verticalAlign=middle;spacing=12;strokeWidth=1.8;fillColor=#F0ECF8;strokeColor=#7E6BA0;rounded=0;" vertex="1" parent="1">
