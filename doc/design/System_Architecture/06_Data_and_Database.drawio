        <mxCell id="ekeys" value="&lt;b&gt;Event checks&lt;/b&gt;&lt;br&gt;cycle_id &amp;gt; 0; occurred_at_ms &amp;gt;= 0; event in {started, stopped}.&lt;br&gt;Start: null duration + dry_soil. Stop: nonnegative duration +&lt;br&gt;allowed reason. No foreign keys or enforced start/stop pair." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#233B43;align=left;verticalAlign=middle;spacing=12;strokeWidth=1.8;fillColor=#F3F5F6;strokeColor=#71818A;rounded=0;dashed=1;" vertex="1" parent="1">
