        <mxCell id="readings" value="&lt;b&gt;public.readings&lt;/b&gt;&lt;br&gt;PK  id: bigint, NOT NULL&lt;br&gt;device_id: text, NOT NULL&lt;br&gt;received_at: timestamptz, NOT NULL, default now()&lt;br&gt;is_test: boolean, NOT NULL, default false&lt;br&gt;sampled_at_ms: bigint, nullable&lt;br&gt;temperature_c, humidity_pct: float8, nullable&lt;br&gt;light_pct, moisture_pct: float8, nullable&lt;br&gt;water_low, pump_on: boolean, nullable&lt;br&gt;light_raw, water_raw, moisture_raw: int, nullable" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#233B43;align=left;verticalAlign=middle;spacing=12;strokeWidth=1.8;fillColor=#F0ECF8;strokeColor=#7E6BA0;rounded=0;" vertex="1" parent="1">
