        </mxCell>
        <mxCell id="rkeys" value="&lt;b&gt;Reading checks and index&lt;/b&gt;&lt;br&gt;Percent fields 0..100; raw fields 0..4095; sampled_at_ms &amp;gt;= 0.&lt;br&gt;Index: (device_id, received_at DESC).&lt;br&gt;Current backend does not insert any *_raw column." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#233B43;align=left;verticalAlign=middle;spacing=12;strokeWidth=1.8;fillColor=#F3F5F6;strokeColor=#71818A;rounded=0;dashed=1;" vertex="1" parent="1">
