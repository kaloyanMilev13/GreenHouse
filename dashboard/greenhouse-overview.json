        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT received_at AS \"Last received\", device_id AS \"Device\", sampled_at_ms AS \"Sample uptime (ms)\", CASE WHEN is_test THEN 'TEST DATA' ELSE 'REAL DATA' END AS \"Data mode\" FROM readings WHERE device_id = '01' AND is_test = (${mode:sqlstring} = 'Test') ORDER BY received_at DESC, id DESC LIMIT 1;"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
