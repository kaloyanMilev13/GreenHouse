          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT received_at AS \"time\", temperature_c AS \"Temperature\" FROM readings WHERE device_id = '01' AND is_test = (${mode:sqlstring} = 'Test') AND $__timeFilter(received_at) ORDER BY received_at, id;"
