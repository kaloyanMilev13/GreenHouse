{
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "Greenhouse PostgreSQL",
      "description": "Select the existing PostgreSQL data source that can SELECT from public.readings.",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "id": null,
  "uid": "greenhouse-overview",
  "title": "Greenhouse Overview",
  "description": "Greenhouse sensor and pump monitoring. Test mode is synthetic. Current cards show the latest stored row; use Reading age to identify stale values. Charts use the selected time range.",
  "tags": [
    "greenhouse"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "mode",
        "label": "Data mode",
        "type": "custom",
        "query": "Test,Real",
        "current": {
          "text": "Test",
          "value": "Test"
        },
        "options": [
          {
            "text": "Test",
            "value": "Test",
            "selected": true
          },
          {
            "text": "Real",
            "value": "Real",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Temperature \u2014 ${mode}",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "Unknown",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT temperature_c AS \"Temperature\" FROM readings WHERE device_id = '01' AND is_test = (${mode:sqlstring} = 'Test') ORDER BY received_at DESC, id DESC LIMIT 1;"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "description": "Value from the latest stored row in the selected data mode. Check Reading age before treating it as current. Null remains Unknown."
    },
