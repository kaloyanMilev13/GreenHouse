    {
      "id": 7,
      "title": "Reading age \u2014 ${mode}",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No readings",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT GREATEST(0, EXTRACT(EPOCH FROM (now() - received_at))) AS \"Seconds since last reading\" FROM readings WHERE device_id = '01' AND is_test = (${mode:sqlstring} = 'Test') ORDER BY received_at DESC, id DESC LIMIT 1;"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "description": "Age of the latest stored row, independent of the chart time range. Red at 30 seconds: a prototype freshness indicator for the two-second publishing interval, not proof of device connectivity."
    },
