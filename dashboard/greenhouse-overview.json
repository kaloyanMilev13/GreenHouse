    {
      "id": 13,
      "title": "Watering history \u2014 ${mode}",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "\u2014",
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Received"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:MM-DD HH:mm:ss"
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Action"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Started": {
                        "text": "Started",
                        "color": "blue",
                        "index": 0
                      },
                      "Stopped": {
                        "text": "Stopped",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: s"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Reason"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Dry soil": {
                        "text": "Dry soil",
                        "color": "blue",
                        "index": 0
                      },
                      "Time limit reached": {
                        "text": "Time limit reached",
                        "color": "green",
                        "index": 1
                      },
                      "Soil no longer dry": {
                        "text": "Soil no longer dry",
                        "color": "green",
                        "index": 2
                      },
                      "Low reservoir": {
                        "text": "Low reservoir",
                        "color": "orange",
                        "index": 3
                      },
                      "Sensor fault": {
                        "text": "Sensor fault",
                        "color": "red",
                        "index": 4
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT received_at AS \"Received\", CASE event WHEN 'started' THEN 'Started' WHEN 'stopped' THEN 'Stopped' ELSE event END AS \"Action\", duration_ms / 1000.0 AS \"Duration\", CASE reason WHEN 'dry_soil' THEN 'Dry soil' WHEN 'time_limit' THEN 'Time limit reached' WHEN 'soil_wet' THEN 'Soil no longer dry' WHEN 'low_water' THEN 'Low reservoir' WHEN 'invalid_sensor' THEN 'Sensor fault' ELSE reason END AS \"Reason\" FROM public.watering_events WHERE device_id = '01' AND is_test = (${mode:sqlstring} = 'Test') AND $__timeFilter(received_at) ORDER BY MAX(received_at) OVER (PARTITION BY boot_id) DESC, boot_id, cycle_id DESC, occurred_at_ms ASC, id ASC LIMIT 500;"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "description": "Watering command history for the selected Test/Real mode and receipt-time range. Received is the database receipt time, not the physical event time. Duration is seconds; a dash on start events means not applicable. Latest boots/cycles first, then device event order within each cycle, so receipt times can appear out of order. Boot IDs and uptime are omitted for readability. A stop command does not confirm physical pump operation. Up to 500 events."
    }
