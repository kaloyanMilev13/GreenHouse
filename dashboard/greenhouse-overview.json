      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT GREATEST(0, EXTRACT(EPOCH FROM (now() - received_at))) AS \"Seconds since last reading\" FROM readings WHERE device_id = '01' AND is_test = (${mode:sqlstring} = 'Test') ORDER BY received_at DESC, id DESC LIMIT 1;"
