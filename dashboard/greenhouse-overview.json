    {
      "id": 14,
      "title": "Current alerts \u2014 ${mode}",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "description": "Current dashboard warnings, refreshed every 5 seconds. Provisional houseplant limits: 16\u201327\u00b0C and 40\u201360% humidity (inclusive). Uses the latest reading in the selected Test/Real mode, independently of the dashboard time range. No data or readings older than 30 seconds produce warnings; stale measurements are not evaluated. Immediate checks, without persistence delay or external notifications. Pump status checks reported command availability, not physical operation.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unknown",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Check"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "FAULT \u2014 humidity sensor": {
                        "text": "FAULT \u2014 humidity sensor",
                        "color": "red",
                        "index": 0
                      },
                      "FAULT \u2014 pump status unavailable": {
                        "text": "FAULT \u2014 pump status unavailable",
                        "color": "red",
                        "index": 1
                      },
                      "FAULT \u2014 reservoir sensor": {
                        "text": "FAULT \u2014 reservoir sensor",
                        "color": "red",
                        "index": 2
                      },
                      "FAULT \u2014 soil sensor": {
                        "text": "FAULT \u2014 soil sensor",
                        "color": "red",
                        "index": 3
                      },
                      "FAULT \u2014 temperature sensor": {
                        "text": "FAULT \u2014 temperature sensor",
                        "color": "red",
                        "index": 4
                      },
                      "HIGH \u2014 above 27\u00b0C": {
                        "text": "HIGH \u2014 above 27\u00b0C",
                        "color": "orange",
                        "index": 5
                      },
                      "HIGH \u2014 above 60%": {
                        "text": "HIGH \u2014 above 60%",
                        "color": "orange",
                        "index": 6
                      },
                      "LOW WATER \u2014 refill reservoir": {
                        "text": "LOW WATER \u2014 refill reservoir",
                        "color": "red",
                        "index": 7
                      },
                      "LOW \u2014 below 16\u00b0C": {
                        "text": "LOW \u2014 below 16\u00b0C",
                        "color": "orange",
                        "index": 8
                      },
                      "LOW \u2014 below 40%": {
                        "text": "LOW \u2014 below 40%",
                        "color": "orange",
                        "index": 9
                      },
                      "NO DATA \u2014 no readings received": {
                        "text": "NO DATA \u2014 no readings received",
                        "color": "red",
                        "index": 10
                      },
                      "OK": {
                        "text": "OK",
                        "color": "green",
                        "index": 11
                      },
                      "STALE \u2014 check device and connection": {
                        "text": "STALE \u2014 check device and connection",
                        "color": "red",
                        "index": 12
                      },
                      "UNKNOWN \u2014 no fresh data": {
                        "text": "UNKNOWN \u2014 no fresh data",
                        "color": "gray",
                        "index": 13
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH latest AS (\n    SELECT received_at, temperature_c, humidity_pct, water_low, moisture_pct, pump_on\n    FROM public.readings\n    WHERE device_id = '01' AND is_test = (${mode:sqlstring} = 'Test')\n    ORDER BY received_at DESC, id DESC\n    LIMIT 1\n), state AS (\n    SELECT latest.*, COALESCE(received_at >= now() - interval '30 seconds', false) AS fresh\n    FROM (VALUES (1)) AS seed(n)\n    LEFT JOIN latest ON true\n)\nSELECT checks.name AS \"Check\", checks.status AS \"Status\"\nFROM state\nCROSS JOIN LATERAL (VALUES\n    (1, 'Incoming data', CASE WHEN received_at IS NULL THEN 'NO DATA \u2014 no readings received' WHEN NOT fresh THEN 'STALE \u2014 check device and connection' ELSE 'OK' END),\n    (2, 'Reservoir', CASE WHEN NOT fresh THEN 'UNKNOWN \u2014 no fresh data' WHEN water_low IS NULL THEN 'FAULT \u2014 reservoir sensor' WHEN water_low THEN 'LOW WATER \u2014 refill reservoir' ELSE 'OK' END),\n    (3, 'Temperature', CASE WHEN NOT fresh THEN 'UNKNOWN \u2014 no fresh data' WHEN temperature_c IS NULL THEN 'FAULT \u2014 temperature sensor' WHEN temperature_c < 16 THEN 'LOW \u2014 below 16\u00b0C' WHEN temperature_c > 27 THEN 'HIGH \u2014 above 27\u00b0C' ELSE 'OK' END),\n    (4, 'Humidity', CASE WHEN NOT fresh THEN 'UNKNOWN \u2014 no fresh data' WHEN humidity_pct IS NULL THEN 'FAULT \u2014 humidity sensor' WHEN humidity_pct < 40 THEN 'LOW \u2014 below 40%' WHEN humidity_pct > 60 THEN 'HIGH \u2014 above 60%' ELSE 'OK' END),\n    (5, 'Soil sensor', CASE WHEN NOT fresh THEN 'UNKNOWN \u2014 no fresh data' WHEN moisture_pct IS NULL THEN 'FAULT \u2014 soil sensor' ELSE 'OK' END),\n    (6, 'Pump status', CASE WHEN NOT fresh THEN 'UNKNOWN \u2014 no fresh data' WHEN pump_on IS NULL THEN 'FAULT \u2014 pump status unavailable' ELSE 'OK' END)\n) AS checks(position, name, status)\nORDER BY checks.position;"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
